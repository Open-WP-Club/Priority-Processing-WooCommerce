#: includes/core/orders.php:38
#: includes/core/orders.php:157
#: includes/core/orders.php:168
msgid "⚡ Priority Processing"
msgstr "⚡ Priority Processing"

#: includes/core/orders.php:39
msgid "This order has priority processing and express shipping"
msgstr "Тази поръчка има приоритетна обработка и експресна доставка"

#: includes/core/orders.php:212
#: includes/core/orders.php:474
msgid "Priority Processing Active"
msgstr "Priority Processing е активно"

#: includes/core/orders.php:213
msgid "Fee: %s"
msgstr "Такса: %s"

#: includes/core/orders.php:220
msgid "Remove Priority Processing"
msgstr "Премахни Priority Processing"

#: includes/core/orders.php:226
msgid "Standard Processing"
msgstr "Стандартна обработка"

#: includes/core/orders.php:230
msgid "Add Priority Processing (+%s)"
msgstr "Добави Priority Processing (+%s)"

#: includes/core/orders.php:234
msgid "New total: %s"
msgstr "Нова сума: %s"

#: includes/core/orders.php:238
msgid "Cannot modify completed/cancelled orders"
msgstr "Не може да се променят завършени/отменени поръчки"

#: includes/core/orders.php:247
msgid "Processing..."
msgstr "Обработка..."

#: includes/core/orders.php:260
msgid "Permission denied"
msgstr "Отказан достъп"

#: includes/core/orders.php:265
msgid "Invalid nonce"
msgstr "Невалиден nonce"

#: includes/core/orders.php:273
msgid "Invalid parameters"
msgstr "Невалидни параметри"

#: includes/core/orders.php:279
msgid "Order not found"
msgstr "Поръчката не е намерена"

#: includes/core/orders.php:286
msgid "Cannot modify this order status"
msgstr "Не може да се променя този статус на поръчката"

#: includes/core/orders.php:300
msgid "Order already has priority processing"
msgstr "Поръчката вече има приоритетна обработка"

#: includes/core/orders.php:314
msgid "Order already has a priority processing fee"
msgstr "Поръчката вече има такса за приоритетна обработка"

#: includes/core/orders.php:336
msgid "⚡ Priority processing added by %s. Fee: %s"
msgstr "⚡ Priority Processing добавен от %s. Такса: %s"

#: includes/core/orders.php:343
msgid "Priority processing added successfully!"
msgstr "Priority Processing е добавен успешно!"

#: includes/core/orders.php:365
msgid "❌ Priority processing removed by %s"
msgstr "❌ Priority Processing премахнат от %s"

#: includes/core/orders.php:371
msgid "Priority processing removed successfully!"
msgstr "Priority Processing е премахнат успешно!"

#: includes/core/orders.php:403
msgid "An error occurred while updating the order"
msgstr "Възникна грешка при актуализиране на поръчката"

#: includes/core/orders.php:428
msgid "Error:"
msgstr "Грешка:"

#: includes/core/orders.php:429
msgid "Connection error. Please try again."
msgstr "Грешка при свързване. Моля, опитайте отново."

#: includes/core/orders.php:455
msgid "Priority Processing Activated!"
msgstr "Priority Processing е активиран!"

#: includes/core/orders.php:458
msgid "Your order includes %s. We'll process and ship your order as quickly as possible!"
msgstr "Вашата поръчка включва %s. Ще обработим и изпратим поръчката ви възможно най-бързо!"

#: includes/core/permissions.php:171
msgid "Shop Managers & Administrators"
msgstr "Мениджъри на магазина и администратори"

#: includes/core/permissions.php:183
msgid "Guest Users"
msgstr "Гост потребители"

#: includes/frontend/messages.php:150
msgid "⚡ Skip the line — add Priority Processing and get your order moving before everyone else's."
msgstr "⚡ Пропусни опашката — добави Priority Processing и изпрати поръчката си преди всички останали."

#: includes/frontend/messages.php:151
msgid "🚀 Time is money. Priority Processing means days less waiting."
msgstr "🚀 Времето е пари. С Priority Processing чакаш с дни по-малко."

#: includes/frontend/messages.php:152
msgid "📦 Your order could be on its way faster — just add Priority Processing."
msgstr "📦 Поръчката ти може да потегли по-бързо — просто добави Priority Processing."

#: includes/frontend/messages.php:153
msgid "🔥 Priority customers get their orders out about 2x faster on average."
msgstr "🔥 Клиентите с приоритет получават поръчките си средно 2 пъти по-бързо."

#: includes/frontend/messages.php:154
msgid "🎯 Need it now, not next week? Priority Processing is for you."
msgstr "🎯 Трябва ти сега, а не другата седмица? Priority Processing е за теб."

#: includes/frontend/messages.php:155
msgid "⏱ Every minute you wait is a minute you didn't have to. Speed things up with one click."
msgstr "⏱ Всяка минута чакане е излишна. Ускори нещата само с едно кликване."

#: includes/frontend/messages.php:169
msgid "⚡ In a hurry for this one? Add Priority Processing at checkout and get it first."
msgstr "⚡ Бързаш за този продукт? Добави Priority Processing при поръчката и го получи първи."

#: includes/frontend/messages.php:170
msgid "🚀 Don't want to wait? Turn on Priority Processing on the next step."
msgstr "🚀 Не искаш да чакаш? Включи Priority Processing на следващата стъпка."

#: includes/frontend/messages.php:171
msgid "🎁 This item is in high demand — Priority Processing helps make sure it reaches you faster."
msgstr "🎁 Този продукт е много търсен — Priority Processing помага да стигне до теб по-бързо."

#: includes/frontend/messages.php:172
msgid "🏆 Our VIP customers choose Priority Processing. Why not you?"
msgstr "🏆 Нашите VIP клиенти избират Priority Processing. Защо не и ти?"

#: includes/frontend/messages.php:173
msgid "📦 Ready to ship the moment you order — with Priority Processing."
msgstr "📦 Готов за изпращане веднага след поръчката — с Priority Processing."

#: includes/frontend/messages.php:174
msgid "⏳ Every extra day of waiting is a day too many. Speed it up with Priority Processing."
msgstr "⏳ Всеки допълнителен ден чакане е излишен. Ускори с Priority Processing."

#: includes/frontend/account.php:90
msgid "⚡ Priority Processing Active"
msgstr "⚡ Активна приоритетна обработка"

#: includes/frontend/account.php:100
msgid "This order is being processed and shipped with priority."
msgstr "Тази поръчка се обработва и изпраща с приоритет."
